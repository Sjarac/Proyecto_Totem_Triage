@startuml Diagrama_de_despliegue
' Vista física (4+1): dónde corre cada componente y cómo se comunican.
' Tótem final: la tablet lee los sensores Bluetooth comerciales directo con bleak (el ESP32 se descartó).
' En el prototipo la lectura la hacen puentes en Python en un PC con la app en modo quiosco.
<style>
document {
  Margin 30
}
</style>
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 70
skinparam ranksep 80
skinparam node {
  BackgroundColor White
  BorderColor #333333
}
skinparam artifact {
  BackgroundColor #F5F5F5
  BorderColor #333333
}
skinparam database {
  BackgroundColor White
  BorderColor #333333
}
skinparam ArrowColor #333333
left to right direction

node "Tótem (gimnasio)" as Totem {
  node "Tablet" <<device>> as Tablet {
    artifact "totem-app\n(React Native / Expo)" as App
    artifact "lectura de sensores\n(Python, bleak)" as Lector
  }
  node "Sensores Bluetooth comerciales" <<device>> as Sensores {
    artifact "Tensiómetro Beurer BM 54" as BM54
    artifact "Oxímetro de pulso" as Oxi
    artifact "Balanza con bioimpedancia" as Balanza
    artifact "Termómetro\n(pendiente)" as Termo
  }
}

node "Render (nube)" <<execution environment>> as Render {
  artifact "backend-totem\n(FastAPI + SQLAlchemy)" as API
  artifact "motor de reglas +\nmodelo XGBoost (opcional)" as Motor
}

database "PostgreSQL" <<database>> as BD {
  artifact "9 tablas\n(socios, sesiones, mediciones,\ninferencias, auditoría...)" as Tablas
}

node "Vercel (nube)" <<execution environment>> as Vercel {
  artifact "triage-dashboard\n(Next.js / React)" as Dash
}

node "PC del gimnasio" <<device>> as PC {
  artifact "Navegador web" as Browser
}

Sensores -- Lector : BLE
Lector -- App : HTTP local
App -- API : HTTPS\nPOST /api/evaluaciones
API -- Motor
API -- BD : TCP 5432\n(SQL)
API -- Browser : WSS\n/ws/dashboard
Browser -- Dash : HTTPS

note bottom of Tablet
  En el prototipo, la lectura con bleak
  corre en un PC con la app en modo
  quiosco; en el tótem final, en la tablet.
end note
@enduml
